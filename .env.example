# ==============================================================================
# AutoSchema & API Auditor Configuration Environment Variables
# ==============================================================================

# Nebius Token Factory Credentials
# Get your API key from Nebius AI Studio (https://studio.nebius.ai)
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Recommended Models for Tool Calling & Reasoning:
# - nvidia/nemotron-3-super-120b-instruct
# - meta-llama/llama-3.1-70b-instruct
# - meta-llama/llama-3.1-405b-instruct
MODEL_NAME=nvidia/nemotron-3-super-120b-instruct

# Tavily Search API Credentials
# Get your API key from Tavily (https://tavily.com)
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_BASE_URL=https://api.tavily.com/search

# Agent Tuning
AGENT_TEMPERATURE=0.1
MAX_TOOL_ITERATIONS=6
DEFAULT_DATABASE_DIALECT=PostgreSQL 16
REPORTS_DIR=reports
